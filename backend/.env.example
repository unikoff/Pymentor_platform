# Backend runtime configuration
# The container image requires DATABASE_URL at runtime.
# Local Python development defaults to backend/test.db (SQLite) when it is unset.
# Set deployment-specific values through the runtime environment/secret store.
DATABASE_URL=sqlite:///./test.db

# Optional; only set when explicitly enabling the dormant Redis-backed session helpers.
REDIS_URL=

# Optional Telegram booking notifications. Leave both empty to disable delivery.
PYMENTOR_PLATFORM_TELEGRAM_BOT_TOKEN=
PYMENTOR_PLATFORM_TELEGRAM_CHAT_ID=

# Landing bot tokens belong in an external secret store, referenced by alias.
# Example shape only; never commit real tokens: {"backend-bot-v1":"<token>"}
PYMENTOR_LANDING_BOT_CREDENTIALS={}

# Optional public code runner; defaults to disabled.
PYMENTOR_PUBLIC_RUNNER_ENABLED=0

# Optional local notification worker; defaults to enabled.
PYMENTOR_LOCAL_NOTIFICATIONS=1
