{
  "apiVersion": "traefik.io/v1alpha1",
  "kind": "IngressRoute",
  "metadata": {
    "labels": {
      "purpose": "vps-preview-no-real-data"
    },
    "name": "preview-domain-https",
    "namespace": "pymentor",
    "annotations": {
      "argocd.argoproj.io/sync-wave": "1"
    }
  },
  "spec": {
    "entryPoints": [
      "websecure"
    ],
    "routes": [
      {
        "kind": "Rule",
        "match": "Host(`13-140-29-11.sslip.io`) && PathRegexp(`^/api/learning/tasks/[^/]+/(run|submit)$`)",
        "middlewares": [
          {
            "name": "preview-runner-rate"
          },
          {
            "name": "preview-runner-inflight"
          }
        ],
        "priority": 90,
        "services": [
          {
            "name": "core-api-weighted",
            "kind": "TraefikService"
          }
        ]
      },
      {
        "kind": "Rule",
        "match": "Host(`13-140-29-11.sslip.io`) && Path(`/api/learning/interpreter/run`)",
        "middlewares": [
          {
            "name": "preview-runner-rate"
          },
          {
            "name": "preview-runner-inflight"
          }
        ],
        "priority": 100,
        "services": [
          {
            "name": "preview-runner-broker",
            "port": 8088
          }
        ]
      },
      {
        "kind": "Rule",
        "match": "Host(`13-140-29-11.sslip.io`) && (Path(`/api`) || PathPrefix(`/api/`) || PathPrefix(`/health`))",
        "priority": 20,
        "services": [
          {
            "name": "core-api-weighted",
            "kind": "TraefikService"
          }
        ]
      },
      {
        "kind": "Rule",
        "match": "Host(`13-140-29-11.sslip.io`) && PathPrefix(`/`)",
        "priority": 10,
        "services": [
          {
            "name": "frontend-weighted",
            "kind": "TraefikService"
          }
        ]
      }
    ],
    "tls": {
      "secretName": "preview-tls"
    }
  }
}
