{
  "components": {
    "schemas": {
      "ActivityVisit": {
        "properties": {
          "activity_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Activity Date"
          }
        },
        "title": "ActivityVisit",
        "type": "object"
      },
      "CodeRunResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "stderr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stderr"
          },
          "stdout": {
            "default": "",
            "title": "Stdout",
            "type": "string"
          },
          "traceback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Traceback"
          }
        },
        "required": [
          "ok"
        ],
        "title": "CodeRunResponse",
        "type": "object"
      },
      "CodeSubmitRequest": {
        "properties": {
          "code": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "task_revision": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Task Revision"
          }
        },
        "required": [
          "code"
        ],
        "title": "CodeSubmitRequest",
        "type": "object"
      },
      "CodeSubmitResponse": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "score": {
            "title": "Score",
            "type": "integer"
          },
          "stderr": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stderr"
          },
          "stdout": {
            "default": "",
            "title": "Stdout",
            "type": "string"
          },
          "tests": {
            "items": {
              "$ref": "#/components/schemas/TestResult"
            },
            "title": "Tests",
            "type": "array"
          },
          "traceback": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Traceback"
          }
        },
        "required": [
          "ok",
          "score",
          "tests"
        ],
        "title": "CodeSubmitResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "InterpreterRunRequest": {
        "properties": {
          "code": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "InterpreterRunRequest",
        "type": "object"
      },
      "LessonTheoryResponse": {
        "properties": {
          "lesson_id": {
            "title": "Lesson Id",
            "type": "string"
          },
          "theory_markdown": {
            "title": "Theory Markdown",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "lesson_id",
          "title",
          "theory_markdown"
        ],
        "title": "LessonTheoryResponse",
        "type": "object"
      },
      "ManualPracticeAnswerResponse": {
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/ManualPracticeTaskAnswerResponse"
          }
        },
        "required": [
          "answer"
        ],
        "title": "ManualPracticeAnswerResponse",
        "type": "object"
      },
      "ManualPracticeTaskAnswerResponse": {
        "properties": {
          "checks": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checks"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Code"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "explanation",
          "steps"
        ],
        "title": "ManualPracticeTaskAnswerResponse",
        "type": "object"
      },
      "TestResult": {
        "properties": {
          "actual": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Actual"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "expected": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Expected"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "passed": {
            "title": "Passed",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "passed"
        ],
        "title": "TestResult",
        "type": "object"
      },
      "UserCreate": {
        "properties": {
          "email": {
            "maxLength": 100,
            "minLength": 5,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 40,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ],
        "title": "UserCreate",
        "type": "object"
      },
      "UserLogin": {
        "properties": {
          "email": {
            "maxLength": 100,
            "minLength": 5,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "UserLogin",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/learning/catalog": {
      "get": {
        "description": "Complete navigation in one request, without lesson bodies or task text.",
        "operationId": "learning_catalog_learning_catalog_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Learning Catalog"
      }
    },
    "/learning/lessons/{lesson_id}": {
      "get": {
        "operationId": "lesson_material_learning_lessons__lesson_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Lesson Material"
      }
    },
    "/learning/lessons/{lesson_id}/complete": {
      "post": {
        "description": "Ручная отметка «Выполнено» — только для уроков с self_check.",
        "operationId": "complete_lesson_learning_lessons__lesson_id__complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Complete Lesson"
      }
    },
    "/learning/lessons/{lesson_id}/manual-practice/{exercise_index}/tasks/{task_index}/answer": {
      "get": {
        "operationId": "manual_practice_answer_learning_lessons__lesson_id__manual_practice__exercise_index__tasks__task_index__answer_get",
        "parameters": [
          {
            "in": "path",
            "name": "lesson_id",
            "required": true,
            "schema": {
              "title": "Lesson Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "exercise_index",
            "required": true,
            "schema": {
              "title": "Exercise Index",
              "type": "integer"
            }
          },
          {
            "in": "path",
            "name": "task_index",
            "required": true,
            "schema": {
              "title": "Task Index",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualPracticeAnswerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Manual Practice Answer"
      }
    },
